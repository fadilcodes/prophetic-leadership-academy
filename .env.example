# URL publik situs untuk redirect checkout dan pembayaran.
# APP_URL dapat mengesampingkan NEXT_PUBLIC_SITE_URL untuk callback Midtrans.
APP_URL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. Publishable key boleh dipakai di browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service role hanya untuk webhook terverifikasi dan operasi sistem di server.
SUPABASE_SERVICE_ROLE_KEY=

# Midtrans Snap API. Server Key hanya boleh dipakai di server.
# Endpoint HTTP Notification Webhook: /api/webhooks/midtrans
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Provider ongkir: biteship atau rajaongkir. Tanpa API key, estimasi hanya tersedia di development.
# Biteship: SHIPPING_ORIGIN_ID adalah kode pos atau area ID.
# RajaOngkir V2: SHIPPING_ORIGIN_ID adalah ID hasil pencarian tujuan domestik.
# SHIPPING_API_BASE_URL opsional, tanpa suffix /v1 (Biteship) atau /api/v1 (RajaOngkir).
SHIPPING_PROVIDER=biteship
SHIPPING_API_BASE_URL=
SHIPPING_API_KEY=
SHIPPING_ORIGIN_ID=

# Resend. Alamat pengirim harus memakai domain yang telah diverifikasi.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Nomor WhatsApp admin dalam format internasional, misalnya 628xxxxxxxxxx.
ADMIN_WHATSAPP_NUMBER=
